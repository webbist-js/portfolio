{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": "Case study / engagement shown on the Work index and case-study pages"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "client": {
      "type": "string",
      "description": "e.g. \"DTC fashion group · 14 brands\""
    },
    "stack": {
      "type": "string",
      "description": "Short stack summary, e.g. \"Strapi 5 · Next.js 15 · Vercel\""
    },
    "year": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "summary": {
      "type": "text",
      "description": "One-paragraph note shown on the work index row"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "kind": {
      "type": "enumeration",
      "enum": [
        "employed",
        "independent"
      ],
      "default": "employed",
      "description": "Employer-led work is labelled as such so it is never mistaken for a commissioned engagement"
    },
    "challenge": {
      "type": "text"
    },
    "responsibility": {
      "type": "text",
      "description": "\"My responsibility\": what I owned versus what the wider team did"
    },
    "approach": {
      "type": "text"
    },
    "outcome": {
      "type": "text"
    },
    "learned": {
      "type": "text",
      "description": "\"What I learned\": a trade-off, a decision that mattered, or what I would do differently"
    },
    "metrics": {
      "type": "component",
      "repeatable": true,
      "component": "shared.metric"
    },
    "tags": {
      "type": "component",
      "repeatable": true,
      "component": "shared.tag"
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
