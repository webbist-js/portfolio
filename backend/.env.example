HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Email (SendGrid) — notifications for form submissions.
# Leave SENDGRID_API_KEY empty in dev: submissions store, emails are skipped.
SENDGRID_API_KEY=
EMAIL_FROM=info@alex-bennett.co.uk
EMAIL_TO=info@alex-bennett.co.uk

# Frontend ISR purge. Leave both empty locally to disable.
# Production: https://www.alex-bennett.co.uk/api/revalidate + the same secret as Vercel.
FRONTEND_REVALIDATE_URL=
REVALIDATE_SECRET=
