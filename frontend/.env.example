# Strapi CMS origin (no trailing slash)
PUBLIC_STRAPI_URL=http://localhost:1337
# Canonical site origin used for SEO tags, sitemap and robots.txt
PUBLIC_SITE_URL=http://localhost:5173
# Fine-grained GitHub PAT (read-only: Contents + Metadata) for the hero
# activity feed. Server-only; optional — feed falls back to CMS activities.
GITHUB_TOKEN=
# Comma-separated owner/repo names allowed on the feed. Unset = no commits.
# The account also holds personal repos; only these are ever shown.
GITHUB_FEED_REPOS=
# Vercel ISR bypass token: any long random string. Build-time (static) env —
# the build fails without it. The same value authenticates on-demand purges.
# Build-time value: rotating it requires a redeploy.
BYPASS_TOKEN=
# Shared secret Strapi sends to POST /api/revalidate (runtime env).
REVALIDATE_SECRET=
